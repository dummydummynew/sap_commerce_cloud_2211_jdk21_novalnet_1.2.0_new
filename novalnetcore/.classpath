<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER">
		<attributes>
			<attribute name="module" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="lib" path="web/webroot/WEB-INF/lib/jakarta.servlet.jsp.jstl-3.0.1.jar"/>
	<classpathentry exported="true" kind="lib" path="resources"/>
	<classpathentry kind="src" output="eclipsebin/classes" path="src"/>
	<classpathentry kind="src" output="eclipsebin/web/classes" path="web/src"/>
	<classpathentry kind="src" output="eclipsebin/classes" path="testsrc"/>
	<classpathentry kind="src" output="eclipsebin/classes" path="gensrc"/>
	<classpathentry combineaccessrules="false" kind="src" path="/commercewebservicescommons"/>
	<classpathentry combineaccessrules="false" kind="src" path="/solrserver"/>
	<classpathentry combineaccessrules="false" kind="src" path="/b2bacceleratorfacades"/>
	<classpathentry combineaccessrules="false" kind="src" path="/ordermanagementfacades"/>
	<classpathentry combineaccessrules="false" kind="src" path="/acceleratorcms"/>
	<classpathentry combineaccessrules="false" kind="src" path="/acceleratorstorefrontcommons"/>
	<classpathentry kind="src" path="/acceleratorfacades"/>
	<classpathentry combineaccessrules="false" kind="src" path="/commerceservices"/>
	<classpathentry kind="src" path="/platform"/>
	<classpathentry combineaccessrules="false" kind="src" path="/acceleratorservices"/>
	<classpathentry combineaccessrules="false" kind="src" path="/commercefacades"/>
	<classpathentry combineaccessrules="false" kind="src" path="/warehousing"/>
	<classpathentry combineaccessrules="false" kind="src" path="/novalnetocc"/>
	<classpathentry kind="output" path="eclipsebin/notused"/>
</classpath>
